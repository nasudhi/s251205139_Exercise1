<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity6">

    <Button
        android:id="@+id/buttonUpdate"
        android:layout_marginTop="16dp"
        android:layout_marginLeft="16dp"
        android:text="更新"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/labelTransport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
       app:layout_constraintTop_toBottomOf="@id/buttonUpdate"
        app:layout_constraintStart_toStartOf="@id/buttonUpdate"
        app:layout_constraintEnd_toStartOf="@+id/textTransport"
        android:text="Transport"
        android:textSize="20dp"/>
    <TextView
        android:id="@+id/textTransport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/labelTransport"
        app:layout_constraintStart_toEndOf="@+id/labelTransport"
        tools:text="WiFi"
        android:textSize="20dp"/>
    <TextView
        android:id="@+id/labelIpAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24dp"
        app:layout_constraintStart_toStartOf="@id/labelTransport"
        app:layout_constraintTop_toBottomOf="@id/labelTransport"
        android:layout_marginTop="16dp"
        android:text="IPアドレス"/>
    <TextView
        android:id="@+id/textIpAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        app:layout_constraintStart_toStartOf="@+id/labelIpAddress"
        app:layout_constraintTop_toBottomOf="@+id/labelIpAddress"
        android:layout_marginTop="16dp"
        tools:text = "10.0.0.16/24"/>

</androidx.constraintlayout.widget.ConstraintLayout>